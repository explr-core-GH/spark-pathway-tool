# Public values (safe in the browser). The real values are in .env for local work.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>

# ---- Server-only secrets: set these in Lovable Cloud (never commit them) ----
# Same project, server side
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service role key; used only by *.server.ts and *.functions.ts>

# Hash peppers. Each must be set; the code falls back to the service-role key
# but never to a public constant. Rotating one invalidates the matching
# codes/cards: EXPLORE_LOGIN_PEPPER (picture sign-in secrets and QR cards),
# FAMILY_CODE_PEPPER (family codes and sessions), ATTESTATION_PEPPER (stamp links).
EXPLORE_LOGIN_PEPPER=<32+ random chars>
FAMILY_CODE_PEPPER=<32+ random chars>
ATTESTATION_PEPPER=<32+ random chars>

# Email (Resend). Stamp requests and internship status mail.
RESEND_API_KEY=<re_...>
RESEND_FROM=EXPLR Pathways <noreply@explrpathways.org>

# ExplrMore (camps and registrations mirror)
EXPLR_API_KEY=<x-api-key for the ExplrMore external-data function>
EXPLR_SUPABASE_URL=https://<explrmore-ref>.supabase.co
EXPLR_SERVICE_ROLE_KEY=<ExplrMore key used to read camps>

# ---- Edge function secret (Supabase → Edge Functions → Secrets) ----
# sync-explr refuses requests without an x-sync-key header matching this value.
# The pg_cron job reads the same value from Supabase Vault (secret name: sync_secret).
SYNC_SECRET=<32+ random chars>
